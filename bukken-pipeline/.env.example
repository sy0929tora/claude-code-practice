# bukken-pipeline 環境変数の雛形
# コピーして .env を作成し、実際の値を入れる。.env はコミットしないこと（.gitignore済み）。

# --- 不動産情報ライブラリ API（国交省）---
# 申請: https://www.reinfolib.mlit.go.jp/api/request/
REINFOLIB_API_KEY=

# --- Google Maps Directions API（通勤時間の実測）---
# 取得: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# --- Gmail API（保存検索メールの取得。OAuthクライアント情報）---
# 取得: https://console.cloud.google.com/apis/credentials （OAuth 2.0 クライアントID・デスクトップアプリ）
# ダウンロードした client_secret.json のパスを指定する（値そのものはコミットしない）
GMAIL_OAUTH_CLIENT_SECRET_PATH=./secrets/gmail_client_secret.json
GMAIL_TOKEN_PATH=./secrets/gmail_token.json
GMAIL_LABEL=bukken

# --- Google Sheets 出力（任意・M5以降）---
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- 通知（任意・M5以降）---
NOTIFY_EMAIL_TO=
LINE_NOTIFY_TOKEN=
