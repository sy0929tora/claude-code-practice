{
  // Cloudflare Workers（静的アセット配信）へのデプロイ設定。
  // このアプリはサーバーサイドのコードを持たない完全な静的SPAなので、
  // "main"（Workerスクリプト）は指定せず、assets のみを配信する。
  "name": "toushi-note",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    // 万一サーバー側で未知のパスにアクセスされた場合も index.html を返す
    // （このアプリ自体はHashRouterを使うため通常は発生しない）
    "not_found_handling": "single-page-application"
  }
}
